# Copy to .env and fill in. Never commit .env.
# Without LLM_BASE_URL the app runs in Preview Mode: rule-based, no AI, clearly labelled.

# --- AI inference: vLLM on AMD Developer Cloud (OpenAI-compatible) ---
LLM_BASE_URL=http://YOUR_DROPLET_IP:8000/v1
LLM_API_KEY=the-same-value-as-VLLM_API_KEY-on-the-droplet
# Optional. If empty, the first model the endpoint lists is used.
LLM_MODEL=
# json_schema (vLLM structured outputs), json_object, or none
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=3
# true if the served model reads images (e.g. google/gemma-3-27b-it): photos are then read by the model on AMD.
LLM_VISION=false

# Optional: a different model or endpoint for the Verifier, so the writer never grades itself.
VERIFIER_BASE_URL=
VERIFIER_MODEL=
VERIFIER_API_KEY=

# --- Neural voice (optional): any OpenAI-compatible /v1/audio/speech service, e.g. Kokoro-FastAPI ---
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=kokoro
TTS_VOICES=af_heart,am_michael,bf_emma
# Languages the voice service actually supports (en, ar, ta). Others use the browser's voices.
TTS_LANGUAGES=en
TTS_LABEL=Neural voice (Kokoro)

# --- Cost display ---
GPU_HOURLY_USD=1.99
HARDWARE_LABEL=AMD Instinct MI300X · ROCm · vLLM

# --- Intake and privacy ---
MAX_UPLOAD_MB=15
MAX_SOURCE_CHARS=30000
MAX_CLAIMS=40
OCR_LANGS=eng
OCR_MAX_PAGES=8
RETENTION_HOURS=72
DATA_DIR=./data
